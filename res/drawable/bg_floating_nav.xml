<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Largest corner of the Material 3 shape scale: bigger than half of the toolbar height,
         so both ends are clamped by the framework into perfect semicircles. -->
    <corners android:radius="@dimen/m3_sys_shape_corner_value_extra_extra_large" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
